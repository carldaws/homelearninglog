<% content_for :title, @activity.name %>

<header class="page-header">
  <div>
    <% if @activity.minutes.present? %>
      <span class="tag"><%= duration(@activity.minutes) %></span>
    <% end %>
    <h1 class="page-title mt-1"><%= @activity.name %></h1>
  </div>
  <%= link_to t(".edit"), edit_activity_path(@activity), class: "button button--secondary button--small" %>
</header>

<% if @activity.notes.present? %>
  <div class="card grid gap-3"><%= notes_with_links(@activity.notes) %></div>
<% end %>

<div class="form-actions mt-6">
  <%= link_to t(".log"), new_activity_entry_path(@activity), class: "button button--wide" %>
  <%= link_to t(".schedule"), new_activity_event_path(@activity), class: "button button--secondary button--wide" %>
</div>

<div class="mt-10">
  <%= render "entries/days", days: @activity.entries.recent_days, show_activity: false %>
</div>
