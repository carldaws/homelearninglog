<%# locals: (activity:) %>
<%= form_with model: activity do |form| %>
  <%= render "shared/errors", record: activity %>

  <div class="fields">
    <div class="field">
      <%= form.label :name, t(".name"), class: "label" %>
      <%= form.text_field :name, required: true, autofocus: true, class: "input" %>
    </div>

    <div class="field">
      <%= form.label :minutes, t(".minutes"), class: "label" %>
      <%= form.select :minutes, duration_options(activity.minutes), { include_blank: true }, class: "input select" %>
    </div>

    <div class="field">
      <%= form.label :notes, t(".notes"), class: "label" %>
      <%= form.textarea :notes, rows: 5, class: "input" %>
    </div>

    <%= render "shared/pursuit_choices", form:, record: activity %>

    <label class="choice">
      <%= form.check_box :for_children, class: "checkbox" %>
      <span class="font-semibold"><%= t(".for_children") %></span>
    </label>

    <div class="field">
      <%= form.label :picture, t(".picture"), class: "label" %>
      <% if activity.picture.attached? && activity.picture.blob.persisted? %>
        <%= image_tag activity_picture_path(activity), alt: "", class: "size-24 rounded-full object-cover" %>
      <% end %>
      <%= form.file_field :picture, accept: "image/*", class: "input" %>
    </div>
  </div>

  <div class="form-actions">
    <%= form.submit (activity.persisted? ? t(".save") : t(".add")), class: "button button--wide" %>
    <%= link_to t(".cancel"), (activity.persisted? ? activity : activities_path), class: "button button--secondary button--wide" %>
  </div>
<% end %>
