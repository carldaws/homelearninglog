<%# locals: (child:) %>
<%= form_with model: child, url: (child.persisted? ? family_child_path(child) : family_children_path) do |form| %>
  <%= render "shared/errors", record: child %>

  <div class="field">
    <%= form.label :name, t(".name"), class: "label" %>
    <%= form.text_field :name, required: true, autofocus: true, autocomplete: "off", class: "input" %>
  </div>

  <div class="form-actions">
    <%= form.submit (child.persisted? ? t(".save") : t(".add")), class: "button button--wide" %>
    <%= link_to t(".cancel"), family_path, class: "button button--secondary button--wide" %>
  </div>
<% end %>
