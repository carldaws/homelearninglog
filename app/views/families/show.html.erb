<% content_for :title, Current.family.name %>

<header class="page-header">
  <div>
    <p class="caption"><%= t(".kicker") %></p>
    <h1 class="page-title mt-1"><%= Current.family.name %></h1>
  </div>
  <%= link_to t(".rename"), edit_family_path, class: "button button--secondary button--small" %>
</header>

<section class="section" aria-labelledby="children-heading">
  <div class="ruled">
    <h2 id="children-heading" class="ruled-title"><%= t(".children") %></h2>
  </div>

  <% if Current.family.children.any? %>
    <ul class="card card--flush list">
      <% Current.family.children.alphabetically.each do |child| %>
        <li class="row">
          <span class="row-title"><%= child.name %></span>
          <%= link_to t(".edit"), edit_family_child_path(child), class: "link link--muted ml-auto",
                aria: { label: t(".edit_child", name: child.name) } %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="empty"><%= t(".no_children") %></p>
  <% end %>

  <%= link_to t(".add_child"), new_family_child_path, class: "button button--secondary mt-4" %>
</section>

<section class="section" aria-labelledby="grown-ups-heading">
  <div class="ruled">
    <h2 id="grown-ups-heading" class="ruled-title"><%= t(".grown_ups") %></h2>
  </div>

  <ul class="card card--flush list">
    <% Current.family.memberships.alphabetically.each do |membership| %>
      <li class="row flex-wrap">
        <span class="row-title"><%= membership.user.name %></span>
        <% if membership.user == Current.user %>
          <span class="caption"><%= t(".you") %></span>
          <%= button_to t(".leave"), family_membership_path(membership), method: :delete, class: "link link--muted ml-auto cursor-pointer",
                form: { class: "ml-auto", data: { turbo_confirm: t(".leave_confirm", family: Current.family.name) } } %>
        <% else %>
          <div class="ml-auto flex items-center gap-4">
            <%= link_to t(".sign_in_link"), family_membership_sign_in_link_path(membership), class: "link link--muted" %>
            <%= button_to t(".remove"), family_membership_path(membership), method: :delete, class: "link link--muted cursor-pointer",
                  form: { data: { turbo_confirm: t(".remove_confirm", name: membership.user.name) } } %>
          </div>
        <% end %>
      </li>
    <% end %>
  </ul>

  <%= link_to t(".invite"), family_invitation_path, class: "button mt-4" %>
</section>
