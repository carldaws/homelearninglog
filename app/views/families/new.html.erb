<% content_for :title, t(".title") %>

<div class="narrow">
  <header class="page-header">
    <div>
      <h1 class="page-title"><%= t(".heading") %></h1>
      <p class="mt-1 text-muted"><%= t(".intro") %></p>
    </div>
  </header>

  <div class="card">
    <%= form_with model: @family, url: family_path do |form| %>
      <%= render "shared/errors", record: @family %>

      <div class="field">
        <%= form.label :name, t(".name"), class: "label" %>
        <%= form.text_field :name, required: true, autofocus: true, class: "input", aria: { describedby: "name-hint" } %>
        <p id="name-hint" class="hint"><%= t(".name_hint") %></p>
      </div>

      <div class="form-actions">
        <%= form.submit t(".submit"), class: "button w-full" %>
      </div>
    <% end %>
  </div>

  <p class="mt-6 text-center text-muted"><%= t(".invited") %></p>
</div>
