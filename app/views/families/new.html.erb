<% content_for :title, t(".title") %>

<header class="page-header">
  <h1 class="page-title"><%= t(".title") %></h1>
</header>

<div class="card">
  <%= form_with model: @family, url: family_path do |form| %>
    <%= render "shared/errors", record: @family %>

    <div class="field">
      <%= form.label :name, t(".name"), class: "label" %>
      <%= form.text_field :name, required: true, autofocus: true, class: "input" %>
    </div>

    <div class="form-actions">
      <%= form.submit t(".submit"), class: "button button--wide" %>
    </div>
  <% end %>
</div>
