<% content_for :title, t(".title") %>

<div class="narrow">
  <header class="page-header">
    <h1 class="page-title"><%= t(".heading") %></h1>
  </header>

  <div class="card">
    <%= form_with model: Current.family, url: family_path, method: :patch do |form| %>
      <%= render "shared/errors", record: Current.family %>

      <div class="field">
        <%= form.label :name, t(".name"), class: "label" %>
        <%= form.text_field :name, required: true, autofocus: true, class: "input" %>
      </div>

      <div class="form-actions">
        <%= form.submit t(".submit"), class: "button button--wide" %>
        <%= link_to t(".cancel"), family_path, class: "button button--secondary button--wide" %>
      </div>
    <% end %>
  </div>
</div>
