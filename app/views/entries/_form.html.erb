<%# locals: (entry:) %>
<%= form_with model: [ entry.child, entry ] do |form| %>
  <%= render "shared/errors", record: entry %>
  <%= form.hidden_field :event_id if entry.event.present? %>
  <%= form.hidden_field :followed_idea_id if entry.followed_idea.present? %>

  <div class="fields">
    <% if entry.followed_idea.present? %>
      <div class="field">
        <span class="label"><%= t(".following_on_from") %></span>
        <p class="break-words"><%= entry.followed_idea.description %></p>
      </div>
    <% end %>

    <div class="field">
      <%= form.label :what_we_did, t(".what_we_did"), class: "label" %>
      <%= form.textarea :what_we_did, rows: 4, class: "input" %>
    </div>

    <div class="field">
      <%= form.label :photos, t(".photos"), class: "label" %>
      <% if entry.saved_photos.any? %>
        <div class="prints mb-2">
          <% entry.saved_photos.each.with_index(1) do |photo, number| %>
            <label class="print cursor-pointer">
              <%= image_tag child_entry_photo_path(entry.child, entry, photo, size: :thumbnail), alt: t(".photo", number:), class: "h-24 w-auto" %>
              <span class="absolute right-2 bottom-2 flex items-center gap-1.5 rounded-[3px] bg-card/90 px-1.5 py-1">
                <%= check_box_tag "entry[photos][]", photo.signed_id, true, id: dom_id(photo), class: "checkbox" %>
                <span class="caption text-ink"><%= t(".keep") %></span>
              </span>
            </label>
          <% end %>
        </div>
      <% end %>
      <%= form.file_field :photos, multiple: true, accept: "image/*", class: "input" %>
    </div>

    <div class="field">
      <%= form.label :what_was_learned, t(".what_was_learned"), class: "label" %>
      <%= form.textarea :what_was_learned, rows: 3, class: "input" %>
    </div>

    <fieldset class="field" data-controller="ideas">
      <legend class="label mb-2"><%= t(".what_could_come_next") %></legend>
      <div class="grid gap-2" data-ideas-target="list">
        <%= form.fields_for :ideas, [ *entry.ideas, Idea.new ] do |idea_form| %>
          <%= idea_form.text_field :description, autocomplete: "off", class: "input", aria: { label: t(".idea") } %>
        <% end %>
      </div>
      <template data-ideas-target="template">
        <%= form.fields_for :ideas, Idea.new, child_index: "NEW_IDEA" do |idea_form| %>
          <%= idea_form.text_field :description, autocomplete: "off", class: "input", aria: { label: t(".idea") } %>
        <% end %>
      </template>
      <button type="button" class="button button--secondary button--small mt-2" data-action="ideas#add"><%= t(".add_idea") %></button>
    </fieldset>

    <div class="grid gap-6 sm:grid-cols-2">
      <div class="field">
        <%= form.label :happened_on, t(".happened_on"), class: "label" %>
        <%= form.date_field :happened_on, max: Date.current, required: true, class: "input" %>
      </div>

      <div class="field">
        <%= form.label :minutes, t(".minutes"), class: "label" %>
        <%= form.select :minutes, duration_options(entry.minutes), { include_blank: true }, class: "input select" %>
      </div>
    </div>
  </div>

  <div class="form-actions">
    <%= form.submit (entry.persisted? ? t(".save") : t(".add")), class: "button button--wide", data: { turbo_submits_with: t(".saving") } %>
    <%= link_to t(".cancel"), (entry.persisted? ? child_log_path(entry.child) : entry.child), class: "button button--secondary button--wide" %>
  </div>
<% end %>
