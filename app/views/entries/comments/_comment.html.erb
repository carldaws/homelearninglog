<%# locals: (comment:, entry:) %>
<li id="<%= dom_id(comment) %>">
  <p class="caption flex flex-wrap gap-x-3">
    <span><%= comment.author.first_name %></span>
    <span><%= l(comment.created_at.to_date, format: :short) %></span>
    <% if comment.author == Current.user %>
      <%= link_to t(".edit"), edit_child_entry_comment_path(entry.child_id, entry, comment), class: "ml-auto text-muted no-underline hover:underline" %>
    <% end %>
  </p>
  <div class="mt-1 grid gap-2 break-words"><%= text_with_links(comment.body) %></div>
</li>
