<%# locals: (entry:, comment:) %>
<%= form_with model: [ entry.child, entry, comment ] do |form| %>
  <%= render "shared/errors", record: comment %>

  <div class="field">
    <%= form.label :body, t(".body"), class: "label" %>
    <%= form.textarea :body, rows: 3, required: true, class: "input" %>
  </div>

  <div class="form-actions">
    <%= form.submit (comment.persisted? ? t(".save") : t(".add")), class: "button button--wide" %>
    <% if comment.persisted? %>
      <%= link_to t(".cancel"), entry_in_log_path(entry), class: "button button--secondary button--wide" %>
    <% end %>
  </div>
<% end %>
