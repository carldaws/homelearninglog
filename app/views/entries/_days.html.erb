<%# locals: (days:, unlogged: {}) %>
<% days.each do |date, entries| %>
  <section class="day" aria-labelledby="<%= date.iso8601 %>">
    <div class="ruled">
      <h2 id="<%= date.iso8601 %>" class="ruled-title"><%= day_heading(date) %></h2>
    </div>
    <div class="stack">
      <%= render partial: "entries/unlogged", collection: unlogged.fetch(date, []), as: :occurrence %>
      <%= render partial: "entries/entry", collection: entries %>
    </div>
  </section>
<% end %>
