<%# locals: (entry:) %>
<article id="<%= dom_id(entry) %>" class="card card--ruled" data-controller="reveal">
  <% if entry.followed_idea.present? %>
    <p class="mb-3 text-sm">
      <span class="caption"><%= t(".following_on_from") %></span>
      <%= link_to entry.followed_idea.description, entry_in_log_path(entry.followed_idea.entry), class: "link link--muted" %>
    </p>
  <% end %>

  <% if entry.photos.attached? %>
    <div class="prints mb-4">
      <% entry.photos.each.with_index(1) do |photo, number| %>
        <%= link_to child_entry_photo_path(entry.child, entry, photo), class: "print", target: "_blank", aria: { label: t(".open_photo", number:) } do %>
          <%= image_tag child_entry_photo_path(entry.child, entry, photo, size: :thumbnail), alt: "", loading: "lazy", class: "h-28 w-auto max-w-full sm:h-36", **photo_size(photo) %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <% if entry.what_we_did.present? %>
    <div class="ruled-text grid gap-7"><%= text_with_links(entry.what_we_did) %></div>
  <% end %>

  <% if entry.what_was_learned.present? %>
    <section class="mt-4">
      <h4 class="entry-label"><%= t(".what_was_learned") %></h4>
      <div class="ruled-text mt-1 grid gap-7"><%= text_with_links(entry.what_was_learned) %></div>
    </section>
  <% end %>

  <% if entry.ideas.any? %>
    <section class="mt-4">
      <h4 class="entry-label"><%= t(".what_could_come_next") %></h4>
      <ul class="ruled-text mt-1 list-disc pl-5 marker:text-muted">
        <% entry.ideas.each do |idea| %>
          <li id="<%= dom_id(idea) %>" class="break-words <%= "text-muted" if idea.set_aside? %>">
            <% if idea.follow_ups.any? %>
              <%= link_to idea.description, entry_in_log_path(idea.follow_ups.first), class: "link" %>
            <% else %>
              <%= idea.description %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <footer class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1">
    <span class="caption"><%= [ entry.author_first_name, (duration(entry.minutes) if entry.minutes.present?) ].compact.join(" · ") %></span>
    <button type="button" class="link link--muted ml-auto cursor-pointer text-sm" aria-expanded="false" aria-controls="<%= dom_id(entry, :new_comment) %>"
            data-reveal-target="button" data-action="reveal#toggle"><%= t(".comment") %></button>
    <%= link_to t(".edit"), edit_child_entry_path(entry.child, entry), class: "link link--muted text-sm" %>
  </footer>

  <% if entry.comments.any? %>
    <ol class="mt-4 grid gap-3 border-t border-line pt-4">
      <%= render partial: "entries/comments/comment", collection: entry.comments %>
    </ol>
  <% end %>

  <div id="<%= dom_id(entry, :new_comment) %>" class="mt-4 border-t border-line pt-4" hidden data-reveal-target="content">
    <%= render "entries/comments/form", entry:, comment: Comment.new %>
  </div>
</article>
