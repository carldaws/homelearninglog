<details class="relative" data-controller="menu">
  <summary class="button button--secondary button--small list-none [&::-webkit-details-marker]:hidden">
    <%= Current.user.first_name %>
  </summary>

  <div class="menu">
    <%# A full page load clears Turbo's cached copies of signed-in pages %>
    <%= button_to t(".sign_out"), session_path, method: :delete, form: { data: { turbo: false } }, class: "menu-item" %>
  </div>
</details>
