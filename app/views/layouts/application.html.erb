<!DOCTYPE html>
<html lang="en-GB">
  <head>
    <title><%= safe_join([ content_for(:title), t("app.name") ].compact, " · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t("app.name") %>">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#2c5a8c" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#1d3a5c" media="(prefers-color-scheme: dark)">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
    <%= yield :head %>

    <%= favicon_link_tag "icon.svg", type: "image/svg+xml" %>
    <%= favicon_link_tag "icon.png", type: "image/png" %>
    <%= favicon_link_tag "icon.png", rel: "apple-touch-icon", type: "image/png" %>
    <%= tag.link rel: "manifest", href: manifest_path(format: :json) %>

    <%= preload_link_tag "instrument-sans.woff2" %>
    <%= preload_link_tag "crimson-pro.woff2" %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-dvh flex-col">
    <div class="cover">
      <header class="page flex items-center justify-between gap-3 pt-[max(0.875rem,env(safe-area-inset-top))] pb-3.5">
        <%= link_to root_path, class: "wordmark" do %>
          <svg aria-hidden="true" viewBox="0 0 28 28" class="size-6 shrink-0 sm:size-7" fill="none" stroke="currentColor"><rect x="4" y="2.5" width="20" height="23" rx="2" stroke-width="1.8"/><rect x="8" y="6.5" width="12" height="6" rx="1" fill="currentColor" stroke="none"/><path d="M8 17h12M8 20.5h8" stroke-width="1.5" stroke-linecap="round"/></svg>
          <%= t("app.name") %>
        <% end %>

        <% if authenticated? %>
          <%= render "layouts/account_link" %>
        <% end %>
      </header>
    </div>

    <% if @child.present? && @child.persisted? %>
      <%= render "layouts/tabs", child: @child %>
    <% end %>

    <main class="page flex-1 pb-28 sm:pb-16">
      <%= render "layouts/flash" %>
      <%= yield %>
    </main>

    <%= render "layouts/footer" %>
  </body>
</html>
