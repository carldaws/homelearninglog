<%# locals: (child:) %>
<details id="child_switcher" class="relative -mb-px" data-controller="menu">
  <summary class="flex max-w-36 cursor-pointer list-none items-center gap-1.5 py-1.5 pr-3 font-display text-[1.2rem] font-semibold text-ink [&::-webkit-details-marker]:hidden">
    <span class="truncate"><%= child.name %></span>
    <svg aria-hidden="true" viewBox="0 0 16 16" class="size-4 shrink-0 text-muted"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </summary>

  <div class="menu menu--start">
    <% Current.user.children.alphabetically.each do |other| %>
      <%= link_to other.name, other, class: "menu-item", aria: { current: ("page" if other == child) } %>
    <% end %>
    <div class="menu-divider"></div>
    <%= link_to t(".add_child"), new_child_path, class: "menu-item" %>
  </div>
</details>
