<%# locals: (child:) %>
<details id="child_switcher" class="relative mr-1" data-controller="menu">
  <summary class="switcher">
    <span class="truncate"><%= child.name %></span>
    <svg aria-hidden="true" viewBox="0 0 16 16" class="size-3.5 shrink-0 text-muted"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </summary>

  <div class="menu menu--start">
    <% Current.user.children.alphabetically.each do |other| %>
      <%= link_to other.name, other, class: "menu-item", aria: { current: ("page" if other == child) } %>
    <% end %>
    <div class="menu-divider"></div>
    <%= link_to t(".add_child"), new_child_path, class: "menu-item" %>
  </div>
</details>
