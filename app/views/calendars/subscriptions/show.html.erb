<% content_for :title, t(".title") %>
<% turbo_exempts_page_from_cache %>

<header class="page-header">
  <h1 class="page-title"><%= t(".title") %></h1>
</header>

<div class="card grid gap-3">
  <%= link_to t(".subscribe"), feed_url(@access.calendar_token, format: :ics, protocol: "webcal"), class: "button button--wide" %>
  <%= render "shared/share_link", url: feed_url(@access.calendar_token, format: :ics), title: @child.name %>
</div>

<%= button_to t(".replace"), child_calendar_subscription_path(@child), method: :patch, class: "button button--secondary button--wide mt-6",
      form: { data: { turbo_confirm: t(".replace_confirm") } } %>
