<%# locals: (occurrence:, with_day: false) %>
<p class="caption flex flex-wrap gap-x-3">
  <% if with_day %>
    <span><%= day_heading(occurrence.date) %></span>
  <% end %>
  <% if occurrence.start_time.present? %>
    <span><%= times(occurrence) %></span>
  <% end %>
  <% if occurrence.grown_up.present? %>
    <span><%= occurrence.grown_up.first_name %></span>
  <% end %>
</p>
