<% content_for :title, t(".title") %>

<header class="page-header">
  <div>
    <p class="caption"><%= l(@week.dates.first, format: :short) %> – <%= l(@week.dates.last, format: :short) %></p>
    <h1 class="page-title mt-1"><%= t(".title") %></h1>
  </div>
  <%= link_to t(".add"), new_child_event_path(@child, date: (@week.starts_on unless @week.current?)), class: "button" %>
</header>

<nav class="mb-8 flex flex-wrap gap-2" aria-label="<%= t(".weeks") %>">
  <%= link_to t(".previous"), child_calendar_path(@child, week: @week.previous), class: "button button--secondary button--small" %>
  <% unless @week.current? %>
    <%= link_to t(".this_week"), child_calendar_path(@child), class: "button button--secondary button--small" %>
  <% end %>
  <%= link_to t(".next"), child_calendar_path(@child, week: @week.following), class: "button button--secondary button--small" %>
  <%= link_to t(".subscribe"), child_calendar_subscription_path(@child), class: "button button--secondary button--small sm:ml-auto" %>
</nav>

<% @week.days.each do |date, occurrences| %>
  <section class="day <%= "day--empty" if occurrences.none? %>" aria-labelledby="<%= date.iso8601 %>">
    <div class="ruled">
      <h2 id="<%= date.iso8601 %>" class="ruled-title"><%= day_heading(date) %></h2>
    </div>
    <% if occurrences.any? %>
      <div class="stack">
        <%= render partial: "calendars/occurrence", collection: occurrences %>
      </div>
    <% end %>
  </section>
<% end %>
