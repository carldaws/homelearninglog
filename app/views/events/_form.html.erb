<%# locals: (event:) %>
<%= form_with model: event, url: (event.persisted? ? event_path(event, week: params[:week]) : events_path), class: "group" do |form| %>
  <%= render "shared/errors", record: event %>

  <div class="fields">
    <div class="field">
      <%= form.label :title, t(".title"), class: "label" %>
      <%= form.text_field :title, required: true, autofocus: event.title.blank?, class: "input" %>
    </div>

    <div class="grid gap-6 sm:grid-cols-3">
      <div class="field">
        <%= form.label :starts_on, t(".starts_on"), class: "label" %>
        <%= form.date_field :starts_on, required: true, class: "input" %>
      </div>

      <div class="field">
        <%= form.label :start_time, t(".start_time"), class: "label" %>
        <%= form.time_field :start_time, class: "input" %>
      </div>

      <div class="field">
        <%= form.label :end_time, t(".end_time"), class: "label" %>
        <%= form.time_field :end_time, class: "input" %>
      </div>
    </div>

    <div class="grid gap-6 sm:grid-cols-2">
      <div class="field">
        <%= form.label :repeats, t(".repeats"), class: "label" %>
        <%= form.select :repeats, Event.repeats.keys.map { [ t(".repeat_options.#{it}"), it ] }, {}, class: "input select" %>
      </div>

      <div class="field group-has-[option[value=never]:checked]:hidden">
        <%= form.label :repeats_until, t(".repeats_until"), class: "label" %>
        <%= form.date_field :repeats_until, class: "input" %>
      </div>
    </div>

    <% if Current.family.children.many? %>
      <fieldset class="field">
        <legend class="label mb-2"><%= t(".children") %></legend>
        <div class="flex flex-wrap gap-x-6 gap-y-3">
          <%= form.collection_check_boxes :child_ids, Current.family.children.alphabetically, :id, :name do |option| %>
            <%= option.label(class: "choice") { option.check_box(class: "checkbox") + option.text } %>
          <% end %>
        </div>
      </fieldset>
    <% else %>
      <%= form.hidden_field :child_ids, multiple: true, value: Current.family.children.first.id %>
    <% end %>

    <div class="field">
      <%= form.label :grown_up_id, t(".grown_up"), class: "label" %>
      <%= form.collection_select :grown_up_id, Current.family.members.alphabetically, :id, :name, { include_blank: true }, class: "input select" %>
    </div>

    <div class="field">
      <%= form.label :notes, t(".notes"), class: "label" %>
      <%= form.textarea :notes, rows: 3, class: "input" %>
    </div>
  </div>

  <div class="form-actions">
    <%= form.submit (event.persisted? ? t(".save") : t(".add")), class: "button button--wide" %>
    <%= link_to t(".cancel"), calendar_path(week: params[:week].presence || event.starts_on_in_database || event.starts_on), class: "button button--secondary button--wide" %>
  </div>
<% end %>
