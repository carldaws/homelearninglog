<%# locals: (event:) %>
<%= form_with model: [ event.child, event ], url: (event.persisted? ? child_event_path(event.child, event, week: params[:week]) : child_events_path(event.child)), class: "group" do |form| %>
  <%= render "shared/errors", record: event %>

  <div class="fields">
    <div class="field">
      <%= form.label :title, t(".title"), class: "label" %>
      <%= form.text_field :title, required: true, autofocus: event.title.blank?, class: "input" %>
    </div>

    <div class="grid gap-6 sm:grid-cols-3">
      <div class="field">
        <%= form.label :starts_on, t(".starts_on"), class: "label" %>
        <%= form.date_field :starts_on, required: true, class: "input" %>
      </div>

      <div class="field">
        <%= form.label :start_time, t(".start_time"), class: "label" %>
        <%= form.time_field :start_time, class: "input" %>
      </div>

      <div class="field">
        <%= form.label :end_time, t(".end_time"), class: "label" %>
        <%= form.time_field :end_time, class: "input" %>
      </div>
    </div>

    <div class="grid gap-6 sm:grid-cols-2">
      <div class="field">
        <%= form.label :repeats, t(".repeats"), class: "label" %>
        <%= form.select :repeats, Event.repeats.keys.map { [ t(".repeat_options.#{it}"), it ] }, {}, class: "input select" %>
      </div>

      <div class="field group-has-[option[value=never]:checked]:hidden">
        <%= form.label :repeats_until, t(".repeats_until"), class: "label" %>
        <%= form.date_field :repeats_until, class: "input" %>
      </div>
    </div>

    <div class="field">
      <%= form.label :grown_up_id, t(".grown_up"), class: "label" %>
      <%= form.collection_select :grown_up_id, event.child.grown_ups.alphabetically, :id, :name, { include_blank: true }, class: "input select" %>
    </div>

    <div class="field">
      <%= form.label :notes, t(".notes"), class: "label" %>
      <%= form.textarea :notes, rows: 3, class: "input" %>
    </div>
  </div>

  <div class="form-actions">
    <%= form.submit (event.persisted? ? t(".save") : t(".add")), class: "button button--wide" %>
    <%= link_to t(".cancel"), child_calendar_path(event.child, week: params[:week].presence || event.starts_on_in_database || event.starts_on), class: "button button--secondary button--wide" %>
  </div>
<% end %>
