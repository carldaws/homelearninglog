<%# locals: (idea:) %>
<article id="<%= dom_id(idea, :suggestion) %>" class="card flex flex-wrap items-center gap-x-4 gap-y-3">
  <div class="min-w-0 flex-1">
    <p class="caption">
      <%= link_to l(idea.entry.happened_on, format: :short), entry_in_log_path(idea.entry), class: "text-muted no-underline hover:underline" %>
      · <%= idea.entry.author.first_name %>
    </p>
    <p class="mt-1 font-semibold break-words"><%= idea.description %></p>
  </div>

  <div class="flex items-center gap-2">
    <%= link_to t(".log"), new_child_idea_entry_path(idea.entry.child_id, idea), class: "button button--secondary button--small" %>
    <%= button_to t(".set_aside"), child_idea_set_aside_path(idea.entry.child_id, idea), class: "button button--secondary button--small" %>
  </div>
</article>
