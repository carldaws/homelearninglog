<% content_for :title, t(".title") %>

<header class="page-header">
  <h1 class="page-title"><%= t(".title") %></h1>
</header>

<%= render partial: "entries/week", collection: @log.weeks %>

<% if @log.earlier.present? %>
  <nav class="mt-10 text-center" aria-label="<%= t(".pagination") %>">
    <%= link_to t(".earlier"), child_log_path(@log.child, through: @log.earlier.iso8601), class: "button button--secondary" %>
  </nav>
<% end %>
