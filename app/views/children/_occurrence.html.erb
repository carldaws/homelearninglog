<%# locals: (occurrence:) %>
<article class="card flex flex-wrap items-center gap-x-4 gap-y-3">
  <div class="min-w-0 flex-1">
    <%= render "calendars/occurrence_details", occurrence: %>
    <h3 class="mt-1 text-[1.35rem] leading-tight font-semibold"><%= occurrence.title %></h3>
  </div>
  <% if occurrence.due? %>
    <%= link_to t(".log"), new_child_event_occurrence_entry_path(occurrence.child, occurrence.event, occurrence.date), class: "button button--small" %>
  <% end %>
</article>
