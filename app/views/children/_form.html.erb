<%# locals: (child:) %>
<%= form_with model: child do |form| %>
  <%= render "shared/errors", record: child %>

  <div class="field">
    <%= form.label :name, t(".name"), class: "label" %>
    <%= form.text_field :name, required: true, autofocus: child.new_record?, autocomplete: "off", class: "input" %>
  </div>

  <div class="form-actions">
    <%= form.submit (child.persisted? ? t(".save") : t(".add")), class: "button button--wide" %>
  </div>
<% end %>
