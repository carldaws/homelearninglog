<% content_for :title, @child.name %>

<header class="page-header">
  <div class="name-label">
    <div class="name-label-row">
      <span class="caption"><%= t(".name") %></span>
      <h1 class="name-label-name"><%= @child.name %></h1>
    </div>
    <div class="name-label-row">
      <span class="caption"><%= t(".date") %></span>
      <span><%= l(Date.current, format: :day) %></span>
    </div>
  </div>

  <%= link_to new_child_entry_path(@child), class: "button button--floating" do %>
    <svg aria-hidden="true" viewBox="0 0 18 18" class="size-4.5"><path d="M9 3v12M3 9h12" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
    <%= t(".add") %>
  <% end %>
</header>

<% @now.days.each do |date, occurrences| %>
  <section class="day" aria-labelledby="<%= date.iso8601 %>">
    <div class="ruled">
      <h2 id="<%= date.iso8601 %>" class="ruled-title"><%= day_heading(date) %></h2>
    </div>
    <div class="stack">
      <%= render partial: "children/occurrence", collection: occurrences %>
    </div>
  </section>
<% end %>

<% if @now.suggestions.any? || @now.set_aside_ideas.any? %>
  <section class="day" aria-labelledby="suggestions">
    <div class="ruled">
      <h2 id="suggestions" class="ruled-title"><%= t(".suggestions") %></h2>
    </div>
    <div class="stack">
      <%= render partial: "ideas/suggestion", collection: @now.suggestions, as: :idea %>
      <% if @now.set_aside_ideas.any? %>
        <%= render "ideas/set_aside", ideas: @now.set_aside_ideas %>
      <% end %>
    </div>
  </section>
<% end %>
