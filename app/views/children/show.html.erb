<% content_for :title, @child.name %>

<header class="page-header">
  <div>
    <p class="caption">
      <%= l(Date.current, format: :short_day) %><% if @log.minutes_this_week.positive? %> · <%= t(".this_week", time: duration(@log.minutes_this_week)) %><% end %>
    </p>
    <h1 class="page-title mt-1"><%= @child.name %></h1>
  </div>

  <%= link_to t(".edit"), edit_child_path(@child), class: "button button--secondary button--small sm:ml-auto" %>

  <%= link_to new_child_entry_path(@child), class: "button button--floating" do %>
    <svg aria-hidden="true" viewBox="0 0 18 18" class="size-4.5"><path d="M9 3v12M3 9h12" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
    <%= t(".add") %>
  <% end %>
</header>

<%= render "entries/days", days: @log.days, unlogged: @log.unlogged %>

<% if @log.earlier.present? %>
  <nav class="mt-10 text-center" aria-label="<%= t(".pagination") %>">
    <%= link_to t(".earlier"), child_path(@child, through: @log.earlier.iso8601), class: "button button--secondary" %>
  </nav>
<% end %>
