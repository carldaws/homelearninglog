<% content_for :title, @child.name_in_database %>

<header class="page-header">
  <h1 class="page-title"><%= @child.name_in_database %></h1>
</header>

<div class="card">
  <%= render "form", child: @child %>
</div>

<% if @child.removable? %>
  <%= button_to t(".remove"), child_path(@child), method: :delete, class: "button button--danger button--wide mt-6",
        form: { data: { turbo_confirm: t(".remove_confirm", name: @child.name_in_database) } } %>
<% end %>
