<% content_for :title, t(".title") %>

<header class="page-header">
  <h1 class="page-title"><%= t(".title") %></h1>
  <%= link_to t(".add"), new_pursuit_path, class: "button" %>
</header>

<% if @pursuits.current.any? %>
  <ul class="stack">
    <% @pursuits.current.each do |pursuit| %>
      <li>
        <%= link_to pursuit, class: "card block text-ink no-underline transition-colors hover:bg-hover" do %>
          <%= render "pursuits/details", pursuit: %>
          <h2 class="mt-1 text-[1.5rem] leading-tight font-semibold"><%= pursuit.name %></h2>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>

<% if @pursuits.finished.any? %>
  <section class="mt-10" aria-labelledby="finished-heading">
    <div class="ruled">
      <h2 id="finished-heading" class="ruled-title"><%= t(".finished") %></h2>
    </div>
    <ul class="card card--flush list">
      <% @pursuits.finished.each do |pursuit| %>
        <li>
          <%= link_to pursuit, class: "row row--link" do %>
            <span class="row-title"><%= pursuit.name %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
