<%# locals: (pursuit:) %>
<%= form_with model: pursuit do |form| %>
  <%= render "shared/errors", record: pursuit %>

  <div class="fields">
    <div class="field">
      <%= form.label :name, t(".name"), class: "label" %>
      <%= form.text_field :name, required: true, autofocus: pursuit.new_record?, class: "input" %>
    </div>

    <% if Current.family.children.many? %>
      <fieldset class="field">
        <legend class="label mb-2"><%= t(".children") %></legend>
        <div class="flex flex-wrap gap-x-6 gap-y-3">
          <%= form.collection_check_boxes :child_ids, Current.family.children.alphabetically, :id, :name do |option| %>
            <%= option.label(class: "choice") { option.check_box(class: "checkbox") + option.text } %>
          <% end %>
        </div>
      </fieldset>
    <% elsif Current.family.children.one? %>
      <%= form.hidden_field :child_ids, multiple: true, value: Current.family.children.first.id %>
    <% end %>

    <div class="field">
      <%= form.label :started_on, t(".started_on"), class: "label" %>
      <%= form.date_field :started_on, required: true, class: "input" %>
    </div>

    <div class="field">
      <%= form.label :notes, t(".notes"), class: "label" %>
      <%= form.textarea :notes, rows: 5, class: "input" %>
    </div>
  </div>

  <div class="form-actions">
    <%= form.submit (pursuit.persisted? ? t(".save") : t(".add")), class: "button button--wide" %>
    <%= link_to t(".cancel"), (pursuit.persisted? ? pursuit : pursuits_path), class: "button button--secondary button--wide" %>
  </div>
<% end %>
