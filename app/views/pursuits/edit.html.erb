<% content_for :title, @pursuit.name_in_database %>

<header class="page-header">
  <h1 class="page-title"><%= @pursuit.name_in_database %></h1>
</header>

<div class="card">
  <%= render "pursuits/form", pursuit: @pursuit %>
</div>

<%= button_to t(".delete"), @pursuit, method: :delete, class: "button button--danger button--wide mt-6",
      form: { data: { turbo_confirm: t(".delete_confirm", name: @pursuit.name_in_database) } } %>
