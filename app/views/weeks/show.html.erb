<% content_for :title, t(".title") %>

<header class="page-header">
  <div>
    <p class="caption">
      <%= t(".days_logged", count: @week.days_logged) %><% if @week.minutes.positive? %> · <%= duration(@week.minutes) %><% end %>
    </p>
    <h1 class="page-title mt-1"><%= l(@week.dates.first, format: :short) %> – <%= l(@week.dates.last, format: :short) %></h1>
  </div>
</header>

<nav class="mb-8 flex flex-wrap gap-2" aria-label="<%= t(".weeks") %>">
  <%= link_to t(".previous"), week_path(week: @week.previous), class: "button button--secondary button--small" %>
  <% unless @week.current? %>
    <%= link_to t(".this_week"), week_path, class: "button button--secondary button--small" %>
  <% end %>
  <%= link_to t(".next"), week_path(week: @week.following), class: "button button--secondary button--small" %>
</nav>

<% if @week.minutes_by_grown_up.any? %>
  <section class="section" aria-labelledby="grown-ups-heading">
    <div class="ruled">
      <h2 id="grown-ups-heading" class="ruled-title"><%= t(".grown_ups") %></h2>
    </div>
    <ul class="card card--flush list">
      <% @week.minutes_by_grown_up.each do |grown_up, minutes| %>
        <li class="row">
          <span class="row-title"><%= grown_up.name %></span>
          <span class="tag ml-auto"><%= duration(minutes) %></span>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<% if @week.pursuit_tallies.any? %>
  <section class="section" aria-labelledby="pursuits-heading">
    <div class="ruled">
      <h2 id="pursuits-heading" class="ruled-title"><%= t(".pursuits") %></h2>
    </div>
    <ul class="card card--flush list">
      <% @week.pursuit_tallies.each do |tally| %>
        <li>
          <%= link_to tally.pursuit, class: "row row--link #{"text-muted" if tally.entries.zero?}" do %>
            <span class="row-title"><%= tally.pursuit.name %></span>
            <span class="ml-auto flex gap-2">
              <span class="tag"><%= t(".entries", count: tally.entries) %></span>
              <% if tally.minutes.positive? %>
                <span class="tag"><%= duration(tally.minutes) %></span>
              <% end %>
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<% if @week.choices.any? %>
  <section class="section" aria-labelledby="choices-heading">
    <div class="ruled">
      <h2 id="choices-heading" class="ruled-title"><%= t(".choices") %></h2>
    </div>
    <ul class="card card--flush list">
      <% @week.choices.each do |choice| %>
        <li>
          <%= link_to choice.activity, class: "row row--link" do %>
            <span class="row-title"><%= choice.activity.name %></span>
            <span class="caption ml-auto"><%= choice.child.name %> · <%= l(choice.created_at.to_date, format: :short_day) %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<section class="section" aria-labelledby="notes-heading">
  <div class="ruled">
    <h2 id="notes-heading" class="ruled-title"><%= t(".notes") %></h2>
  </div>
  <%= form_with model: @week.reflection, url: week_reflection_path(week: @week.starts_on), method: :patch, class: "card" do |form| %>
    <%= form.label :notes, t(".notes"), class: "sr-only" %>
    <%= form.textarea :notes, rows: 6, class: "input" %>
    <div class="form-actions mt-4">
      <%= form.submit t(".save"), class: "button button--wide" %>
    </div>
  <% end %>
</section>
