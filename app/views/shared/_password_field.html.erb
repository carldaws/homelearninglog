<%# locals: (form:, field:, autocomplete:, label:) %>
<div class="field" data-controller="password-reveal" data-password-reveal-show-value="<%= t(".show") %>" data-password-reveal-hide-value="<%= t(".hide") %>">
  <%= form.label field, label, class: "label" %>
  <div class="relative">
    <%= form.password_field field, required: true, autocomplete:, class: "input pr-20", data: { password_reveal_target: "input" } %>
    <button type="button" class="button button--secondary button--small absolute top-1 right-1 border-transparent bg-transparent shadow-none"
            data-password-reveal-target="button" data-action="password-reveal#toggle" aria-pressed="false">
      <%= t(".show") %>
    </button>
  </div>
</div>
