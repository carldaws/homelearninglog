<%# locals: (form:, record:) %>
<% choices = record.pursuit_choices %>
<% if choices.any? %>
  <fieldset class="field">
    <legend class="label mb-2"><%= t(".pursuits") %></legend>
    <div class="flex flex-wrap gap-x-6 gap-y-3">
      <%= form.collection_check_boxes :pursuit_ids, choices, :id, :name do |option| %>
        <%= option.label(class: "choice") { option.check_box(class: "checkbox") + option.text } %>
      <% end %>
    </div>
  </fieldset>
<% end %>
