<% content_for :title, t(".title") %>

<header class="page-header">
  <h1 class="page-title"><%= t(".title") %></h1>
</header>

<div class="grid gap-4 sm:grid-cols-2">
  <% Current.family.children.alphabetically.each do |child| %>
    <%= button_to child.name, kids_mode_path, params: { child_id: child.id }, class: "card w-full cursor-pointer py-10 text-center font-display text-[2rem] font-semibold text-ink hover:bg-hover" %>
  <% end %>
</div>
