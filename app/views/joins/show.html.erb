<% content_for :title, @family.name %>

<div class="card mt-6 text-center sm:mt-10">
  <h1 class="page-title"><%= @family.name %></h1>
  <p class="caption mt-3"><%= @family.members.alphabetically.map(&:first_name).to_sentence %></p>

  <div class="mt-8 grid gap-3">
    <% if !authenticated? %>
      <%= link_to t(".register"), new_registration_path, class: "button" %>
      <%= link_to t(".sign_in"), new_session_path, class: "button button--secondary" %>
    <% elsif Current.family == @family %>
      <%= link_to t(".open"), entries_path, class: "button" %>
    <% elsif Current.family.nil? %>
      <%= button_to t(".join", family: @family.name), joins_path, params: { token: params[:token] }, class: "button w-full" %>
    <% end %>
  </div>
</div>
